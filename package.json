{
  "name": "prismatic-hydrostatics",
  "version": "1.0.0",
  "description": "Local prismatic hull static floating attitude and righting-arm analysis backend.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/server.js",
    "stop": "node scripts/stop.mjs",
    "demo": "npm run build && node --experimental-sqlite dist/demo.js",
    "test": "npm run build && node --experimental-sqlite --test dist/test/index.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
